# Auth0 walkthrough: docs/PRIVATE_SETUP.ru.md
# Origin only, no trailing slash. Auth0 API Identifier/audience = PUBLIC_URL + /mcp.
PUBLIC_URL=https://your-service.up.railway.app
# Copy exact issuer and jwks_uri from Auth0 OIDC discovery.
OAUTH_ISSUER=https://your-tenant.eu.auth0.com/
OAUTH_JWKS_URL=https://your-tenant.eu.auth0.com/.well-known/jwks.json
# Generate privately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
DATABASE_PATH=/data/acmp.sqlite3
# Separate ACMP Portal Regular Web Application, token endpoint auth = Post.
# ChatGPT's own client ID/secret belong only in ChatGPT connection settings.
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
OIDC_AUTHORIZATION_ENDPOINT=https://your-tenant.eu.auth0.com/authorize
OIDC_TOKEN_ENDPOINT=https://your-tenant.eu.auth0.com/oauth/token
SUBMISSION_INTERVAL=30
ACMP_SESSION_TTL=604800
PORT=8000
# Local loopback HTTP only. Keep 0 in production.
ACMP_DEV=0
